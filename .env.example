# Path to the Google service account JSON key file you downloaded during setup
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Your FREE Gemini API key (from aistudio.google.com/apikey — no card needed)
GEMINI_API_KEY=
